// Ad-hoc signing by default (used by CI). To sign with your own certificate,
// create Config/Local.xcconfig (git-ignored) with:
//
//   CODE_SIGN_STYLE = Automatic
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = YOUR_TEAM_ID

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
